<!-- Views/UserDashboard/Index.cshtml -->
@{
    Layout = "_Layout";
    var appointments = (IEnumerable<ClinicAppointmentSystem.Models.Appointment>)ViewBag.Appointments;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5>Your appointments</h5>
    <a class="btn btn-primary" asp-action="Book">Book appointment</a>
</div>
<table class="table table-striped">
    <thead>
        <tr><th>Date</th><th>Department</th><th>Status</th><th>Notes</th></tr>
    </thead>
    <tbody>
        @foreach (var ap in appointments)
        {
            <tr>
                <td>@ap.ScheduledAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@ap.Department</td>
                <td>@ap.Status</td>
                <td>@ap.Notes</td>
            </tr>
        }
        @if (!appointments.Any())
        {
            <tr><td colspan="4" class="text-muted">No appointments yet.</td></tr>
        }
    </tbody>
</table>