<!-- Views/UserDashboard/Book.cshtml -->
@model ClinicAppointmentSystem.Models.AppointmentBookingViewModel
@{
    Layout = "_Layout";
}
<div class="card shadow-sm">
    <div class="card-header bg-white"><h5 class="mb-0">Book an appointment</h5></div>
    <div class="card-body">
        <form asp-action="Book" method="post" class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Date & time</label>
                <input asp-for="ScheduledAt" type="datetime-local" class="form-control" />
                <span asp-validation-for="ScheduledAt" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">Department</label>
                <select asp-for="Department" class="form-select">
                    <option>General Medicine</option>
                    <option>Pediatrics</option>
                    <option>Dermatology</option>
                    <option>Dental</option>
                </select>
                <span asp-validation-for="Department" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label class="form-label">Notes</label>
                <textarea asp-for="Notes" rows="3" class="form-control"></textarea>
            </div>
            <div class="col-12">
                <button class="btn btn-primary">Submit</button>
                <a asp-action="Index" class="btn btn-link">Cancel</a>
            </div>
        </form>
    </div>
</div>