<!-- Views/Shared/_Layout.cshtml -->
@{
    var isAuthenticated = Context.User?.Identity?.IsAuthenticated ?? false;
    var name = isAuthenticated ? Context.User.Identity!.Name : "Guest";
    var role = isAuthenticated ? Context.User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Clinic Appointment System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">Clinic</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    @if (isAuthenticated && role == "Admin")
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="AdminDashboard" asp-action="Index">Admin Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="AdminDashboard" asp-action="Appointments">Appointments</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="AdminDashboard" asp-action="Users">Users</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="AdminDashboard" asp-action="Admins">Admins</a></li>
                    }
                    @if (isAuthenticated && role == "User")
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="UserDashboard" asp-action="Index">User Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="UserDashboard" asp-action="Book">Book Appointment</a></li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (isAuthenticated)
                    {
                        <li class="nav-item"><span class="navbar-text me-3">Hello, @name</span></li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button class="btn btn-outline-light btn-sm">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container">
        @if (TempData["Msg"] != null)
        {
            <div class="alert alert-info">@TempData["Msg"]</div>
        }
        @if (TempData["ResetLink"] != null)
        {
            <div class="alert alert-warning">
                Demo reset link: <a href="@TempData["ResetLink"]">@TempData["ResetLink"]</a>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="mt-5">
        <div class="container text-muted small border-top pt-3">
            &copy; @DateTime.Now.Year Clinic Appointment System
        </div>
    </footer>
    @RenderSection("Scripts", required: false)
</body>
</html>