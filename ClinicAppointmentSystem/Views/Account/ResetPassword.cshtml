<!-- Views/Account/ResetPassword.cshtml -->
@model ClinicAppointmentSystem.ViewModels.ResetPasswordViewModel
@{
    Layout = "_Layout";
}
<div class="card shadow-sm">
    <div class="card-header bg-white"><h5 class="mb-0">Reset password</h5></div>
    <div class="card-body">
        <form asp-action="ResetPassword" method="post" class="row g-3">
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />
            <div class="col-12">
                <label class="form-label">New password</label>
                <input asp-for="NewPassword" type="password" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="col-12">
                <button class="btn btn-primary">Reset</button>
            </div>
        </form>
    </div>
</div>